; call.gas — subroutine overhead.
;
; `call` pushes the frame pointer and a return address; `ret` unwinds
; both. Against `dispatch.gas` the difference is what the stack costs,
; which is memory traffic the flat ALU loop never touches.

main:
  mov $0008, r6
.outer:
  mov $FFFF, r1
.inner:
  call work
  djnz r1, .inner
  djnz r6, .outer
  hlt

work:
  add $0001, r2
  ret
